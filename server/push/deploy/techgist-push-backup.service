# Nightly backup of push.db (push/backup.py): one consistent snapshot, integrity-checked, the newest 7 kept in
# /var/lib/techgist/backups/nightly as push-<time>.db. A failed backup alerts through OnFailure=.
[Unit]
Description=Techgist nightly push registry backup
OnFailure=techgist-alert@%n.service

[Service]
Type=oneshot
User=techgist
Group=techgist
WorkingDirectory=/opt/techgist-push
Environment=TECHGIST_STATE=/var/lib/techgist
Environment=PYTHONPATH=/opt/techgist-push
ExecStart=/opt/techgist-push/venv/bin/python -m push.backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/techgist
UMask=0027
