# Sends an ntfy alert when the unit named by %i fails (OnFailure= in techgist-worker.service and
# techgist-backup.service). systemd passes what happened in MONITOR_SERVICE_RESULT / MONITOR_EXIT_STATUS.
[Unit]
Description=Techgist alert for %i

[Service]
Type=oneshot
User=techgist
Group=techgist
EnvironmentFile=-/etc/techgist/env
# /run/techgist-alert: the rate limit's memory (one message per 15 min per unit in a crash loop).
RuntimeDirectory=techgist-alert
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/techgist/deploy/alert.py --unit-failed %i
# No topic (exit 3) or ntfy unreachable (exit 1) is logged by the script; it is not a failure of this unit.
SuccessExitStatus=1 3
